{
    "version": 8,
    "name": "Trail Buddy USGS Topo + Trails",
    "sources": {                                                                                                          
      "usgs-topo": {
        "type": "raster",
        "tiles": ["https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}"],
        "tileSize": 128,
        "minzoom": 0,
        "maxzoom": 16,
        "attribution": "Map services and data available from U.S. Geological Survey, National Geospatial Program."
      },
      "trailbuddy-roads": {                                                                                               
        "type": "vector",
        "tiles": ["https://pmtiles-cloudflare.linstrom-david.workers.dev/conus-z14/{z}/{x}/{y}.mvt"],
        "minzoom": 0,
        "maxzoom": 14,
        "attribution": "Trail data as of August 5, 2026, &copy; <a href=\"https://www.openstreetmap.org/copyright\"       
  target=\"_blank\">OpenStreetMap</a> contributors — for legal route status, see the MVUM layer."
      }
    },
    "layers": [
      { "id": "background", "type": "background", "paint": { "background-color": "#e9e5da" } },                         
      { "id": "usgs-topo", "type": "raster", "source": "usgs-topo", "minzoom": 0, "maxzoom": 22 },                        
      {
        "id": "trailbuddy-trails",
        "type": "line",
        "source": "trailbuddy-roads",
        "source-layer": "roads",                                                                                          
        "minzoom": 0,
        "maxzoom": 22,
        "filter": ["all", ["==", ["get", "kind"], "path"], ["!=", ["get", "kind_detail"], "track"]],
        "paint": { "line-color": "#8a6d3b", "line-width": 1, "line-dasharray": [2, 2], "line-opacity": 0.85 }
      },
      {
        "id": "trailbuddy-tracks",
        "type": "line",
        "source": "trailbuddy-roads",
        "source-layer": "roads",
        "minzoom": 0,
        "maxzoom": 22,
        "filter": ["all", ["==", ["get", "kind"], "path"], ["==", ["get", "kind_detail"], "track"]],                      
        "paint": { "line-color": "#a0522d", "line-width": 1.5, "line-dasharray": [4, 2], "line-opacity": 0.95 }
      }
    ]
  }

